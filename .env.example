# DeepSeek — get a key at https://platform.deepseek.com
# Leave empty to run the assistant in demo mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Secret used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Optional. Defaults to ./.data/tutorly.db
# DATABASE_PATH=./.data/tutorly.db
