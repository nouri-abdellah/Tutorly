SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# Configure exactly one JWT verification mode.
# Supabase CLI 3.x signs local Auth tokens asymmetrically by default:
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# For a symmetric HS256 deployment, comment out SUPABASE_JWKS_URL and use:
# SUPABASE_JWT_SECRET=replace-with-local-jwt-secret
# Do not configure SUPABASE_JWKS_URL and SUPABASE_JWT_SECRET at the same time.
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
